{
  "author": {
    "email": "dario@casertano.name",
    "name": "Dario Casertano (DarCas)",
    "url": "https://casertano.name"
  },
  "bin": {
    "refero-design-mcp": "dist/cli.js"
  },
  "bugs": {
    "url": "https://github.com/DarCas/refero-design-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "description": "MCP server for design research on styles.refero.design: search curated website styles, then extract colours, type scale, spacing and dos/donts as design.md",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/DarCas/refero-design-mcp#readme",
  "keywords": [
    "mcp",
    "design-system",
    "design-tokens",
    "design-research",
    "design.md"
  ],
  "license": "MIT",
  "name": "@darcas/refero-design-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarCas/refero-design-mcp.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "deploy": "npm run verify && npm publish --access public --provenance",
    "dev": "tsx watch src/cli.ts",
    "lint": "eslint src test",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "type": "module",
  "version": "1.0.2"
}
