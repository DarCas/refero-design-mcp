{
  "author": {
    "email": "dario@casertano.name",
    "name": "Dario Casertano (DarCas)",
    "url": "https://casertano.name"
  },
  "bin": {
    "refero-design-mcp": "dist/cli.js",
    "refero-design-mcp-http": "dist/cli-http.js",
    "refero-design-skill": "dist/skill/install.js"
  },
  "bugs": {
    "url": "https://github.com/DarCas/refero-design-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^4.6.5"
  },
  "description": "MCP server and Agent Skill for evidence-based design research. Searches curated website styles on styles.refero.design and extracts real design systems — colours, type scale, spacing, surfaces, dos and donts — as design.md, so a coding agent implements from measured evidence instead of inventing a visual direction.",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://inspirai.os.darcas.app",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "design-tokens",
    "design-research",
    "design-md",
    "agent-skill",
    "design-inspiration"
  ],
  "license": "MIT",
  "name": "@darcas/refero-design-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarCas/refero-design-mcp.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "deploy": "npm run clean && npm run verify && npm run publish",
    "dev": "tsx watch src/cli.ts",
    "dev:http": "tsx watch src/cli-http.ts",
    "lint": "eslint src test",
    "publish": "npm publish --access public",
    "start": "node dist/cli.js",
    "start:http": "node dist/cli-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "type": "module",
  "version": "1.4.0"
}
